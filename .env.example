# Copy to .env and fill in. .env is gitignored - never commit real keys.

# ---------------------------------------------------------------------------
# LLM provider. The app runs WITHOUT any key using LLM_PROVIDER=local, which
# uses deterministic rule-based extraction only (no narrative synthesis).
# ---------------------------------------------------------------------------
# anthropic | openai | local
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Email notifications (Resend). Every completed run is emailed to
# REPORT_EMAIL_TO with the one-pager and CSV attached. Without RESEND_API_KEY
# the app still generates normally; it just does not email.
# RESEND_FROM must be an address on a domain verified at resend.com/domains.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
REPORT_EMAIL_TO=Info@tencapital.group
RESEND_FROM=TEN Capital <reports@tencapital.group>
RESEND_REPLY_TO=
ENABLE_EMAIL=true
# Attach the sources JSON as well as the PDF and CSV.
EMAIL_ATTACH_JSON=false

# ---------------------------------------------------------------------------
# Public investor research. OFF by default. When off, nothing is fetched and
# every investor claim comes only from the documents you supply.
# ---------------------------------------------------------------------------
ENABLE_PUBLIC_RESEARCH=false

# Research backend: none | brave | serper
# Both require an API key; without one, research stays disabled and is labelled
# as such in the output rather than being silently faked.
RESEARCH_BACKEND=none
BRAVE_API_KEY=
SERPER_API_KEY=
RESEARCH_MAX_QUERIES_PER_INVESTOR=3
RESEARCH_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
OUTPUT_DIR=output
# letter | a4
PAGE_SIZE=letter
MAX_UPLOAD_MB=64
